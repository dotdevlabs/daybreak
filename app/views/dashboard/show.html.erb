<% content_for :title, "Daybreak — Today's Briefing" %>

<div class="dashboard">
  <%= render "header" %>

  <% if @briefing %>
    <!-- Row 1: Glanceable widgets (equal height) -->
    <div class="dashboard__widgets-row">
      <%= render "date_widget", briefing: @briefing %>
      <%= render "weather_widget", briefing: @briefing %>
      <%= render "daily_goals_widget", briefing: @briefing %>
    </div>

    <!-- Action Items -->
    <%= render "section", title: "Action Items", icon: "list-checks" do %>
      <%= render "action_items", briefing: @briefing %>
    <% end %>

    <!-- Long Term Goals -->
    <%= render "section", title: "Long Term Goals", icon: "target" do %>
      <%= render "long_term_goals", briefing: @briefing %>
    <% end %>

    <!-- Agent Activity -->
    <%= render "section", title: "Agent Activity", icon: "bot" do %>
      <%= render "agent_activity", briefing: @briefing %>
    <% end %>

    <%= render "footer", briefing: @briefing %>
  <% else %>
    <div class="dashboard__empty">
      <i data-lucide="sun"></i>
      <p>No briefing available for today. Check back soon.</p>
    </div>
  <% end %>
</div>
