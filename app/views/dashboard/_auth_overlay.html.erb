<% unless authenticated? %>
  <div class="auth-overlay"
       data-controller="auth-overlay"
       data-auth-overlay-mode-value="<%= @overlay_mode || 'login' %>">
    <div class="auth-overlay__panel">
      <div class="auth-overlay__logo">
        <%= render "dashboard/logo" %>
      </div>

      <div class="auth-overlay__tabs" role="tablist">
        <button class="auth-overlay__tab"
                data-auth-overlay-target="loginTab"
                data-action="auth-overlay#showLogin"
                role="tab">
          <%= t("auth.login.title") %>
        </button>
        <button class="auth-overlay__tab"
                data-auth-overlay-target="registerTab"
                data-action="auth-overlay#showRegister"
                role="tab">
          <%= t("auth.register.title") %>
        </button>
      </div>

      <div data-auth-overlay-target="loginPane">
        <% if @auth_error.present? %>
          <div class="auth-overlay__error" role="alert"><%= @auth_error %></div>
        <% end %>
        <%= form_with url: session_path, class: "auth-overlay__form" do |f| %>
          <%= f.email_field :email_address,
                placeholder: t("auth.login.email_placeholder"),
                required: true,
                autocomplete: "email",
                class: "auth-overlay__input" %>
          <%= f.password_field :password,
                placeholder: t("auth.login.password_placeholder"),
                required: true,
                autocomplete: "current-password",
                class: "auth-overlay__input" %>
          <%= f.submit t("auth.login.submit"), class: "btn btn--primary btn--full" %>
        <% end %>
        <div class="auth-overlay__footer-links">
          <%= link_to t("auth.login.forgot_password"), new_password_path, class: "auth-overlay__link" %>
        </div>
      </div>

      <div data-auth-overlay-target="registerPane">
        <% if @auth_errors.present? %>
          <ul class="auth-overlay__errors" role="alert">
            <% Array(@auth_errors).each do |error| %>
              <li><%= error %></li>
            <% end %>
          </ul>
        <% end %>
        <%= form_with url: registration_path, class: "auth-overlay__form" do |f| %>
          <%= f.email_field :email_address,
                placeholder: t("auth.register.email_placeholder"),
                required: true,
                autocomplete: "email",
                class: "auth-overlay__input" %>
          <%= f.password_field :password,
                placeholder: t("auth.register.password_placeholder"),
                required: true,
                autocomplete: "new-password",
                class: "auth-overlay__input" %>
          <%= f.password_field :password_confirmation,
                placeholder: t("auth.register.password_confirmation_placeholder"),
                required: true,
                autocomplete: "new-password",
                class: "auth-overlay__input" %>
          <%= f.submit t("auth.register.submit"), class: "btn btn--primary btn--full" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
