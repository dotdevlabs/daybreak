<% unless authenticated? %>
  <div class="auth-overlay"
       data-controller="auth-overlay"
       data-auth-overlay-step-value="signup-email">
    <div class="auth-overlay__panel">
      <div class="auth-overlay__logo">
        <%= render "dashboard/logo" %>
      </div>

      <%# ── Step: signup-email ── %>
      <div data-auth-overlay-target="signupEmail">
        <h2 class="auth-page__title"><%= t("auth.register.title") %></h2>
        <form class="auth-overlay__form" data-action="submit->auth-overlay#submitSignupEmail">
          <input type="email" name="email_address"
                 placeholder="<%= t("auth.register.email_placeholder") %>"
                 required autocomplete="email"
                 class="auth-overlay__input"
                 data-auth-overlay-target="signupEmailInput">
          <button type="submit" class="btn btn--primary btn--full">
            <%= t("auth.register.submit") %>
          </button>
        </form>
        <div class="auth-overlay__footer-links">
          <button class="auth-overlay__link" style="background:none;border:none;cursor:pointer;"
                  data-action="auth-overlay#showSignin">
            <%= t("auth.login.toggle") %>
          </button>
        </div>
      </div>

      <%# ── Step: signup-method ── %>
      <div data-auth-overlay-target="signupMethod" hidden>
        <h2 class="auth-page__title"><%= t("auth.method.choose") %></h2>
        <div class="auth-overlay__form">
          <button class="btn btn--primary btn--full" data-action="auth-overlay#startPasskeyRegistration">
            <i data-lucide="fingerprint"></i>
            <%= t("auth.method.passkey_label") %>
          </button>
          <p style="font-size:13px;color:var(--color-fg-muted);text-align:center;margin:0;">
            <%= t("auth.method.passkey_description") %>
          </p>
        </div>
      </div>

      <%# ── Step: check-email ── %>
      <div data-auth-overlay-target="checkEmail" hidden>
        <h2 class="auth-page__title"><%= t("auth.email_verification.check_inbox") %></h2>
        <div class="auth-overlay__form">
          <p style="font-size:14px;color:var(--color-fg-muted);text-align:center;margin:0;"
             data-auth-overlay-target="pendingEmail"></p>
          <button class="btn btn--outline btn--full" data-action="auth-overlay#resendEmail">
            <%= t("auth.email_verification.resend") %>
          </button>
        </div>
      </div>

      <%# ── Step: signin-email ── %>
      <div data-auth-overlay-target="signinEmail" hidden>
        <h2 class="auth-page__title"><%= t("auth.login.title") %></h2>
        <form class="auth-overlay__form" data-action="submit->auth-overlay#submitSigninEmail">
          <input type="email" name="email_address"
                 placeholder="<%= t("auth.login.email_placeholder") %>"
                 required autocomplete="email"
                 class="auth-overlay__input"
                 data-auth-overlay-target="signinEmailInput">
          <button type="submit" class="btn btn--primary btn--full">
            <%= t("auth.login.submit") %>
          </button>
        </form>
        <div class="auth-overlay__footer-links">
          <button class="auth-overlay__link" style="background:none;border:none;cursor:pointer;"
                  data-action="auth-overlay#showSignup">
            <%= t("auth.register.toggle") %>
          </button>
        </div>
      </div>

      <%# ── Error display ── %>
      <div data-auth-overlay-target="errorMessage" class="auth-overlay__error" hidden></div>
    </div>
  </div>
<% end %>
