<div class="dashboard__header"
     data-controller="clock"
     data-clock-user-name-value="<%= ENV.fetch('DAYBREAK_USER_NAME', '') %>"
     data-clock-locale-value="<%= I18n.locale %>"
     data-clock-greeting-morning-value="<%= t('dashboard.greeting.morning') %>"
     data-clock-greeting-afternoon-value="<%= t('dashboard.greeting.afternoon') %>"
     data-clock-greeting-evening-value="<%= t('dashboard.greeting.evening') %>">
  <div class="header__logo">
    <%= render "dashboard/logo" %>
  </div>
  <div class="header__right">
    <div class="header__clock">
      <span class="header__clock-time" data-clock-target="time">--:--</span>
      <span class="header__clock-ampm" data-clock-target="ampm">--</span>
    </div>
    <div class="header__meta">
      <span class="header__greeting" data-clock-target="greeting"><%= t("dashboard.greeting.morning") %></span>
      <span class="header__date" data-clock-target="date"><%= I18n.l(Date.current, format: :long) %></span>
    </div>
    <% if authenticated? %>
      <div class="header__auth">
        <%= link_to t("auth.passkey.manage"), credentials_path, class: "btn btn--ghost btn--sm" %>
        <%= button_to t("auth.sign_out"), session_path, method: :delete,
                      class: "btn btn--ghost btn--sm" %>
      </div>
    <% end %>
  </div>
</div>
