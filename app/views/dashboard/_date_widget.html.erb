<%
  week_start = briefing.date.beginning_of_week(:sunday)
  week_end   = week_start + 6.days
%>
<div class="widget date-widget">
  <div class="widget__header">
    <i data-lucide="calendar" class="widget__header-icon"></i>
    <h3 class="widget__title"><%= t("dashboard.calendar.title") %></h3>
    <span class="widget__header-caption">
      <%= I18n.l(week_start, format: :short) %> &ndash; <%= week_end.day %>
    </span>
  </div>

  <!-- Mini week calendar -->
  <div class="calendar-week">
    <div class="calendar-week__header">
      <% I18n.t("date.abbr_day_names").each do |d| %>
        <span class="calendar-week__day-label"><%= d.first(2) %></span>
      <% end %>
    </div>
    <div class="calendar-week__dates">
      <% (0..6).each do |offset| %>
        <% day = week_start + offset.days %>
        <% is_today = day == briefing.date %>
        <div class="calendar-week__date <%= "calendar-week__date--today" if is_today %>">
          <span class="calendar-week__date-num"><%= day.day %></span>
          <% if is_today && briefing.calendar_events.any? %>
            <span class="calendar-week__event-dot"></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Today's Schedule -->
  <% if briefing.calendar_events.any? %>
    <div class="schedule-section">
      <p class="schedule-label"><%= t("dashboard.calendar.todays_schedule") %></p>
      <ul class="schedule-list">
        <% dot_colors = ["var(--color-event-dot-1)", "var(--color-event-dot-2)", "var(--color-event-dot-3)"] %>
        <% briefing.calendar_events.each_with_index do |event, i| %>
          <li class="schedule-event">
            <span class="schedule-event__time"><%= event["time"] || "&mdash;".html_safe %></span>
            <span class="schedule-event__dot" style="background: <%= event["dot_color"] || dot_colors[i % 3] %>"></span>
            <span class="schedule-event__name"><%= event["title"] %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <p class="widget__empty"><%= t("dashboard.calendar.no_events_today") %></p>
  <% end %>
</div>
