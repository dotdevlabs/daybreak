<% content_for :title, t("app.title") %>

<div class="dashboard">
  <%= render "header" %>

  <% if @briefing %>
    <!-- Row 1: Glanceable widgets (equal height) -->
    <div class="dashboard__widgets-row">
      <%= render "date_widget", briefing: @briefing %>
      <%= render "weather_widget", briefing: @briefing %>
      <%= render "daily_goals_widget", briefing: @briefing %>
    </div>

    <!-- Action Items -->
    <%= render "section", title: t("dashboard.sections.action_items"), icon: "list-checks" do %>
      <%= render "action_items", briefing: @briefing %>
    <% end %>

    <!-- Long Term Goals -->
    <%= render "section", title: t("dashboard.sections.long_term_goals"), icon: "target" do %>
      <%= render "long_term_goals", briefing: @briefing %>
    <% end %>

    <!-- Agent Activity -->
    <%= render "section", title: t("dashboard.sections.agent_activity"), icon: "bot" do %>
      <%= render "agent_activity", briefing: @briefing %>
    <% end %>

    <%= render "footer", briefing: @briefing %>
  <% else %>
    <div class="dashboard__empty">
      <i data-lucide="sun"></i>
      <p><%= t("dashboard.no_briefing") %></p>
    </div>
  <% end %>
</div>
