<div class="agent-activity">
  <% briefing.agent_activities.each do |activity| %>
    <div class="agent-activity-card" data-controller="card-overflow">
      <div class="agent-activity-card__inner" data-card-overflow-target="content">
        <div class="agent-activity-card__top-row">
          <span class="agent-activity-card__title"><%= activity["text"] %></span>
          <span class="agent-activity-card__timestamp"><%= activity["timestamp"] %></span>
        </div>
        <% if activity["body"].present? %>
          <p class="agent-activity-card__body"><%= activity["body"] %></p>
        <% end %>
        <div class="agent-activity-card__status">
          <% status = activity["status"] || t("dashboard.agent_activity.completed_status") %>
          <span class="status-dot status-dot--<%= status.downcase %>"></span>
          <span class="status-label"><%= status %></span>
        </div>
      </div>
      <div class="agent-activity-card__fade" data-card-overflow-target="fade" hidden></div>
    </div>
  <% end %>
</div>
