<div class="auth-page">
  <div class="auth-page__panel">
    <%= render "dashboard/logo" %>

    <h1 class="auth-page__title"><%= t("auth.passkey.manage") %></h1>

    <% if notice.present? %>
      <div class="auth-overlay__error" style="background: rgba(34,197,94,0.1); border-color: rgba(34,197,94,0.3); color: #16a34a;" role="alert">
        <%= notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="auth-overlay__error" role="alert"><%= alert %></div>
    <% end %>

    <div class="credentials-list">
      <% @credentials.each do |credential| %>
        <div class="credential-item" data-controller="credential-rename">
          <div class="credential-item__info">
            <i data-lucide="key"></i>
            <div>
              <span class="credential-item__name" data-credential-rename-target="display"><%= credential.nickname.presence || t("auth.passkey.unnamed") %></span>
              <span class="credential-item__date"><%= I18n.l(credential.created_at, format: :long) %></span>
            </div>
          </div>
          <div class="credential-item__actions">
            <%= button_to t("auth.passkey.rename"), "#",
                  class: "btn btn--ghost btn--sm",
                  "data-action": "credential-rename#startEdit",
                  form_class: "credential-rename-btn-form" %>
            <%= button_to t("auth.passkey.remove"), credential_path(credential), method: :delete,
                  class: "btn btn--ghost btn--sm",
                  disabled: @credentials.count <= 1,
                  title: @credentials.count <= 1 ? t("auth.passkey.cannot_remove_last") : nil,
                  data: { confirm: t("auth.passkey.remove_confirm") } %>
          </div>
          <form class="credential-item__rename-form" data-credential-rename-target="form" hidden
                action="<%= credential_path(credential) %>" method="post">
            <input type="hidden" name="_method" value="patch">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <input type="text" name="nickname" value="<%= credential.nickname %>"
                   class="auth-overlay__input" data-credential-rename-target="input" style="flex:1">
            <button type="submit" class="btn btn--primary btn--sm"><%= t("auth.passkey.save") %></button>
            <button type="button" class="btn btn--ghost btn--sm" data-action="credential-rename#cancelEdit">
              <%= t("auth.passkey.cancel") %>
            </button>
          </form>
        </div>
      <% end %>
    </div>

    <div class="auth-overlay__form"
         data-controller="add-passkey"
         data-add-passkey-challenge-url-value="<%= credentials_challenge_path %>"
         data-add-passkey-save-url-value="<%= credentials_path %>">
      <button class="btn btn--primary btn--full" data-action="add-passkey#addPasskey">
        <i data-lucide="fingerprint"></i>
        <%= t("auth.passkey.add") %>
      </button>
      <div class="auth-overlay__error" data-add-passkey-target="error" hidden></div>
    </div>

    <%= link_to t("dashboard.back"), root_path, class: "auth-overlay__link" %>
  </div>
</div>
